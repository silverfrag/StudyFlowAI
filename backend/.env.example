# StudyFlow AI Backend - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

APP_NAME="StudyFlow AI Backend"
APP_ENV="development"
APP_DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/studyflow_db"

# Storage Settings (Local file storage for PDF/TXT)
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=20

# Gemini Developer API Settings (Backend only)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

